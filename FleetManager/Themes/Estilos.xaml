<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:FleetManager.ViewModels"
                    xmlns:modelos="clr-namespace:FleetManager.Models"
                    xmlns:core="clr-namespace:FleetManager.Core">

    <!-- Los estilos usan los colores de Colores.xaml. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Colores.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- ================= Paneles y textos ================= -->

    <!-- Recuadro con fondo gris oscuro para agrupar información. -->
    <Style x:Key="Panel" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Pincel.Panel}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="20,16" />
    </Style>

    <!-- Título de un panel. -->
    <Style x:Key="TituloPanel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Pincel.Texto}" />
        <Setter Property="Margin" Value="0,0,0,10" />
    </Style>

    <!-- Título de una sección (arriba del todo). -->
    <Style x:Key="TituloSeccion" TargetType="TextBlock">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Pincel.Texto}" />
        <Setter Property="Margin" Value="0,0,0,16" />
    </Style>

    <Style x:Key="Etiqueta" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Pincel.TextoSecundario}" />
        <Setter Property="Margin" Value="0,4,16,4" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="Valor" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Pincel.Texto}" />
        <Setter Property="Margin" Value="0,4,0,4" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ================= Botones ================= -->

    <!-- Botones en tema oscuro (se aplica a todos los botones). -->
    <Style TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Pincel.Texto}" />
        <Setter Property="Background" Value="{StaticResource Pincel.Boton}" />
        <Setter Property="BorderBrush" Value="{StaticResource Pincel.Borde}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="Margin" Value="0,0,8,8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Fondo"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fondo" Property="Background" Value="{StaticResource Pincel.BotonEncima}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Fondo" Property="Background" Value="{StaticResource Pincel.BotonPulsado}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Botón de actividad: con una franja del color de la actividad a la izquierda (Tag). -->
    <Style x:Key="BotonActividad" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="BorderThickness" Value="4,1,1,1" />
        <Setter Property="BorderBrush" Value="{Binding Tag, RelativeSource={RelativeSource Self}}" />
        <Setter Property="MinWidth" Value="120" />
    </Style>

    <!-- ================= Menú lateral ================= -->

    <Style x:Key="ElementoMenu" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource Pincel.TextoSecundario}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Fondo" Background="Transparent" Padding="0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Marca" Background="Transparent" CornerRadius="2" />
                            <ContentPresenter Grid.Column="1" Margin="18,0,12,0" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fondo" Property="Background" Value="{StaticResource Pincel.Panel}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Fondo" Property="Background" Value="{StaticResource Pincel.Seleccion}" />
                            <Setter TargetName="Marca" Property="Background" Value="{StaticResource Pincel.BarraNormal}" />
                            <Setter Property="Foreground" Value="{StaticResource Pincel.Texto}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= Interruptor (CheckBox) ================= -->

    <Style x:Key="Interruptor" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource Pincel.Texto}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Grid Width="36" Height="20" VerticalAlignment="Center">
                            <Border x:Name="Carril" CornerRadius="10" Background="{StaticResource Pincel.BarraFondo}" />
                            <Ellipse x:Name="Bola" Width="14" Height="14" Margin="3,0" Fill="White" HorizontalAlignment="Left" />
                        </Grid>
                        <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Carril" Property="Background" Value="{StaticResource Pincel.BarraNormal}" />
                            <Setter TargetName="Bola" Property="HorizontalAlignment" Value="Right" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= Campos de texto ================= -->

    <Style TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource Pincel.Texto}" />
        <Setter Property="Background" Value="{StaticResource Pincel.Campo}" />
        <Setter Property="BorderBrush" Value="{StaticResource Pincel.Borde}" />
        <Setter Property="CaretBrush" Value="{StaticResource Pincel.Texto}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="Margin" Value="0,4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Borde"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Borde" Property="BorderBrush" Value="{StaticResource Pincel.BarraNormal}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= Tabla (DataGrid) ================= -->

    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="{StaticResource Pincel.Panel}" />
        <Setter Property="Foreground" Value="{StaticResource Pincel.Texto}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="RowBackground" Value="{StaticResource Pincel.Panel}" />
        <Setter Property="AlternatingRowBackground" Value="#303030" />
        <Setter Property="GridLinesVisibility" Value="None" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="RowHeight" Value="28" />
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserDeleteRows" Value="False" />
        <Setter Property="CanUserResizeRows" Value="False" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="SelectionMode" Value="Extended" />
        <Setter Property="SelectionUnit" Value="FullRow" />
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{StaticResource Pincel.Lateral}" />
        <Setter Property="Foreground" Value="{StaticResource Pincel.TextoSecundario}" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="BorderBrush" Value="{StaticResource Pincel.Borde}" />
        <Setter Property="BorderThickness" Value="0,0,1,1" />
    </Style>

    <Style TargetType="DataGridCell">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource Pincel.Seleccion}" />
                <Setter Property="Foreground" Value="White" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ================= Árbol (TreeView) ================= -->

    <Style TargetType="TreeView">
        <Setter Property="Background" Value="{StaticResource Pincel.Panel}" />
        <Setter Property="Foreground" Value="{StaticResource Pincel.Texto}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="4,8" />
    </Style>

    <!-- ================= Casilla normal (CheckBox) ================= -->

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource Pincel.Texto}" />
        <Setter Property="Margin" Value="0,4" />
    </Style>

    <!-- ================= Barras ================= -->

    <!-- Barra fina con esquinas redondeadas. El color depende del Nivel del indicador enlazado. -->
    <Style x:Key="Barra" TargetType="ProgressBar">
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="1" />
        <Setter Property="Height" Value="8" />
        <Setter Property="Background" Value="{StaticResource Pincel.BarraFondo}" />
        <Setter Property="Foreground" Value="{StaticResource Pincel.BarraNormal}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="4" />
                        <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="4" HorizontalAlignment="Left" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Nivel}" Value="{x:Static vm:NivelIndicador.Atencion}">
                <Setter Property="Foreground" Value="{StaticResource Pincel.BarraAtencion}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Nivel}" Value="{x:Static vm:NivelIndicador.Agotado}">
                <Setter Property="Foreground" Value="{StaticResource Pincel.BarraAgotada}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Nivel}" Value="{x:Static vm:NivelIndicador.Objetivo}">
                <Setter Property="Foreground" Value="{StaticResource Pincel.BarraObjetivo}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- ================= Tacógrafo (ventana principal y mini) ================= -->
    <!-- Estos estilos se usan con un TacografoViewModel como DataContext. -->

    <!-- Franja con el color de la actividad actual (gris si no hay jornada). -->
    <Style x:Key="FranjaActividad" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Pincel.Descanso}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Actividad}" Value="{x:Static modelos:Actividad.Conduccion}">
                <Setter Property="Background" Value="{StaticResource Pincel.Conduccion}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Actividad}" Value="{x:Static modelos:Actividad.OtrosTrabajos}">
                <Setter Property="Background" Value="{StaticResource Pincel.OtrosTrabajos}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Actividad}" Value="{x:Static modelos:Actividad.Disponibilidad}">
                <Setter Property="Background" Value="{StaticResource Pincel.Disponibilidad}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding JornadaAbierta}" Value="False">
                <Setter Property="Background" Value="{StaticResource Pincel.Boton}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Número de la velocidad: naranja con exceso, rojo a los 10 s. -->
    <Style x:Key="TextoVelocidad" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Pincel.Texto}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding NivelVelocidad}" Value="{x:Static core:NivelVelocidad.Exceso}">
                <Setter Property="Foreground" Value="{StaticResource Pincel.BarraAtencion}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding NivelVelocidad}" Value="{x:Static core:NivelVelocidad.ExcesoProlongado}">
                <Setter Property="Foreground" Value="{StaticResource Pincel.Urgente}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding NivelVelocidad}" Value="{x:Static core:NivelVelocidad.Peligro}">
                <Setter Property="Foreground" Value="{StaticResource Pincel.Urgente}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding NivelVelocidad}" Value="{x:Static core:NivelVelocidad.Falta}">
                <Setter Property="Foreground" Value="{StaticResource Pincel.Urgente}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Símbolo de peligro: solo aparece desde los 30 s de exceso, y parpadea. -->
    <Storyboard x:Key="Parpadeo" RepeatBehavior="Forever" AutoReverse="True">
        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.15" Duration="0:0:0.5" />
    </Storyboard>

    <Style x:Key="SimboloPeligro" TargetType="TextBlock">
        <Setter Property="Text" Value="⚠" />
        <Setter Property="Foreground" Value="{StaticResource Pincel.Urgente}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding NivelVelocidad}" Value="{x:Static core:NivelVelocidad.Peligro}">
                <Setter Property="Visibility" Value="Visible" />
                <DataTrigger.EnterActions>
                    <BeginStoryboard x:Name="ParpadeoPeligro" Storyboard="{StaticResource Parpadeo}" />
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <StopStoryboard BeginStoryboardName="ParpadeoPeligro" />
                </DataTrigger.ExitActions>
            </DataTrigger>
            <DataTrigger Binding="{Binding NivelVelocidad}" Value="{x:Static core:NivelVelocidad.Falta}">
                <Setter Property="Visibility" Value="Visible" />
                <DataTrigger.EnterActions>
                    <BeginStoryboard x:Name="ParpadeoFalta" Storyboard="{StaticResource Parpadeo}" />
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <StopStoryboard BeginStoryboardName="ParpadeoFalta" />
                </DataTrigger.ExitActions>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Texto de un aviso (DataContext = Aviso): color según la urgencia. -->
    <Style x:Key="TextoAviso" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Pincel.Informacion}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Nivel}" Value="{x:Static vm:NivelAviso.Atencion}">
                <Setter Property="Foreground" Value="{StaticResource Pincel.BarraAtencion}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Nivel}" Value="{x:Static vm:NivelAviso.Urgente}">
                <Setter Property="Foreground" Value="{StaticResource Pincel.Urgente}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Cómo se dibuja un indicador de tiempo: título, "usado / límite", barra y lo que queda. -->
    <DataTemplate DataType="{x:Type vm:IndicadorTiempo}">
        <StackPanel Margin="0,0,0,14">
            <Grid>
                <TextBlock Text="{Binding Titulo}" Foreground="{StaticResource Pincel.TextoSecundario}" />
                <TextBlock HorizontalAlignment="Right" Foreground="{StaticResource Pincel.Texto}">
                    <Run Text="{Binding Usado, Mode=OneWay}" FontWeight="SemiBold" />
                    <Run Text="/" Foreground="{StaticResource Pincel.TextoSecundario}" />
                    <Run Text="{Binding Limite, Mode=OneWay}" Foreground="{StaticResource Pincel.TextoSecundario}" />
                </TextBlock>
            </Grid>
            <ProgressBar Style="{StaticResource Barra}" Value="{Binding Fraccion, Mode=OneWay}" Margin="0,6,0,4" />
            <TextBlock Text="{Binding Restante}" FontSize="11" Foreground="{StaticResource Pincel.TextoSecundario}" HorizontalAlignment="Right" />
        </StackPanel>
    </DataTemplate>

    <!-- Cómo se dibuja un indicador en porcentaje: título, valor y barra. -->
    <DataTemplate DataType="{x:Type vm:IndicadorPorcentaje}">
        <StackPanel Margin="0,0,0,12">
            <Grid>
                <TextBlock Text="{Binding Titulo}" Foreground="{StaticResource Pincel.TextoSecundario}" />
                <TextBlock Text="{Binding Texto}" HorizontalAlignment="Right" Foreground="{StaticResource Pincel.Texto}" />
            </Grid>
            <ProgressBar Style="{StaticResource Barra}" Value="{Binding Fraccion, Mode=OneWay}" Margin="0,6,0,0" />
        </StackPanel>
    </DataTemplate>

</ResourceDictionary>
