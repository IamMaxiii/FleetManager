<UserControl x:Class="FleetManager.Views.SeccionHistorial"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:FleetManager.ViewModels"
             xmlns:vistas="clr-namespace:FleetManager.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:HistorialViewModel}">

    <!-- DataContext: HistorialViewModel. -->

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="SiNoAVisibilidad" />
        <vistas:NuloAOculto x:Key="NuloAOculto" />
        <vistas:InversoAVisibilidad x:Key="InversoAVisibilidad" />

        <!-- Texto de error de un panel de edición: solo se ve si hay errores. -->
        <Style x:Key="TextoErrores" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Pincel.Urgente}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,8,0,0" />
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Panel de edición de un trayecto. -->
        <DataTemplate DataType="{x:Type vm:EdicionTrayectoViewModel}">
            <StackPanel>
                <TextBlock Text="{Binding Titulo}" Style="{StaticResource TituloPanel}" />

                <TextBlock Text="Origen" Style="{StaticResource Etiqueta}" />
                <TextBox Text="{Binding Origen}" />
                <TextBlock Text="Destino" Style="{StaticResource Etiqueta}" />
                <TextBox Text="{Binding Destino}" />
                <TextBlock Text="Carga" Style="{StaticResource Etiqueta}" />
                <TextBox Text="{Binding Carga}" />

                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Km" Style="{StaticResource Etiqueta}" />
                        <TextBox Text="{Binding Kilometros}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Media" Style="{StaticResource Etiqueta}" />
                        <TextBox Text="{Binding VelocidadMedia}" />
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Máxima" Style="{StaticResource Etiqueta}" />
                        <TextBox Text="{Binding VelocidadMaxima}" />
                    </StackPanel>
                </Grid>

                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Column="1" Text="Día" Style="{StaticResource Etiqueta}" />
                    <TextBlock Grid.Column="3" Text="Hora (HH:mm)" Style="{StaticResource Etiqueta}" />
                    <TextBlock Grid.Row="1" Text="Inicio" Style="{StaticResource Etiqueta}" />
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding DiaInicio}" />
                    <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding HoraInicio}" />
                    <TextBlock Grid.Row="2" Text="Fin" Style="{StaticResource Etiqueta}" />
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding DiaFin}" />
                    <TextBox Grid.Row="2" Grid.Column="3" Text="{Binding HoraFin}" />
                </Grid>

                <CheckBox Content="Falta de velocidad" IsChecked="{Binding FaltaVelocidad}" Margin="0,10,0,0" />
                <CheckBox Content="Falta de conducción" IsChecked="{Binding FaltaConduccion}" />

                <TextBlock Text="{Binding Errores}" Style="{StaticResource TextoErrores}" />

                <WrapPanel Margin="0,12,0,0">
                    <Button Content="Guardar" Command="{Binding ComandoGuardar}" />
                    <Button Content="Descartar" Command="{Binding ComandoDescartar}" />
                </WrapPanel>
            </StackPanel>
        </DataTemplate>

        <!-- Panel de edición de una jornada. -->
        <DataTemplate DataType="{x:Type vm:EdicionJornadaViewModel}">
            <StackPanel>
                <TextBlock Text="{Binding Titulo}" Style="{StaticResource TituloPanel}" />

                <TextBlock Text="La jornada abierta no se puede editar: ciérrala primero."
                           Foreground="{StaticResource Pincel.Aviso}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Editable}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <Grid IsEnabled="{Binding Editable}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Column="1" Text="Día" Style="{StaticResource Etiqueta}" />
                    <TextBlock Grid.Column="3" Text="Hora (HH:mm)" Style="{StaticResource Etiqueta}" />
                    <TextBlock Grid.Row="1" Text="Inicio" Style="{StaticResource Etiqueta}" />
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding DiaInicio}" />
                    <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding HoraInicio}" />
                    <TextBlock Grid.Row="2" Text="Fin" Style="{StaticResource Etiqueta}" />
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding DiaFin}" />
                    <TextBox Grid.Row="2" Grid.Column="3" Text="{Binding HoraFin}" />
                </Grid>

                <TextBlock Text="{Binding Errores}" Style="{StaticResource TextoErrores}" />

                <WrapPanel Margin="0,12,0,0">
                    <Button Content="Guardar" Command="{Binding ComandoGuardar}" />
                    <Button Content="Descartar" Command="{Binding ComandoDescartar}" />
                </WrapPanel>

                <TextBlock Text="Para editar un trayecto, elígelo en la tabla."
                           FontSize="11"
                           Margin="0,8,0,0"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource Pincel.TextoSecundario}" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.ColumnSpan="4" Text="Historial" Style="{StaticResource TituloSeccion}" />

        <!-- ===== Botones y mensaje ===== -->
        <StackPanel Grid.Row="1" Grid.ColumnSpan="4" Margin="0,0,0,12">
            <WrapPanel>
                <Button Content="Exportar a CSV" Command="{Binding ComandoExportar}"
                        ToolTip="Exporta los trayectos elegidos en la tabla o, si no hay ninguno elegido, todos los que se ven." />
                <Button Content="Exportar todo" Command="{Binding ComandoExportarTodo}" />
                <Button Content="Borrar trayectos elegidos" Command="{Binding ComandoBorrarSeleccionados}" Margin="24,0,8,8" />
                <Button Content="Borrar jornada" Command="{Binding ComandoBorrarJornada}" />
                <Button Content="Borrar todo" Command="{Binding ComandoBorrarTodo}" />
            </WrapPanel>
            <TextBlock Text="{Binding Mensaje}" TextWrapping="Wrap" Foreground="{StaticResource Pincel.Informacion}" />
        </StackPanel>

        <!-- ===== Árbol: jornadas → días → trayectos ===== -->
        <Border Grid.Row="2" CornerRadius="8" Background="{StaticResource Pincel.Panel}" Padding="4">
            <TreeView ItemsSource="{Binding Arbol}"
                      SelectedItemChanged="Arbol_SelectedItemChanged"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <TreeView.Resources>
                    <!-- Colores de la selección del árbol en tema oscuro. -->
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#33475B" />
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="White" />
                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#33475B" />
                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="White" />
                </TreeView.Resources>
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem">
                        <Setter Property="IsExpanded" Value="{Binding Expandido, Mode=TwoWay}" />
                        <Setter Property="IsSelected" Value="{Binding Seleccionado, Mode=TwoWay}" />
                        <Setter Property="Foreground" Value="{StaticResource Pincel.Texto}" />
                        <Setter Property="Padding" Value="4,3" />
                    </Style>
                </TreeView.ItemContainerStyle>
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate DataType="{x:Type vm:NodoHistorial}" ItemsSource="{Binding Hijos}">
                        <StackPanel Margin="0,2">
                            <TextBlock Text="{Binding Titulo}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Detalle}" FontSize="11" TextTrimming="CharacterEllipsis" Foreground="{StaticResource Pincel.TextoSecundario}" />
                        </StackPanel>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
        </Border>

        <!-- ===== Tabla de trayectos o mapa del recorrido ===== -->
        <Grid Grid.Row="2" Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <CheckBox Content="Ver en el mapa" IsChecked="{Binding VerMapa}" Style="{StaticResource Interruptor}" Margin="4,0,0,10" />

            <!-- Mapa del recorrido de lo elegido (la parte elegida, en naranja). -->
            <Border Grid.Row="1" CornerRadius="8" ClipToBounds="True" Background="#161616"
                    Visibility="{Binding VerMapa, Converter={StaticResource SiNoAVisibilidad}}">
                <Grid>
                    <vistas:LienzoMapa Recorrido="{Binding Recorrido}"
                                       ResaltadoDesde="{Binding ResaltadoDesde}"
                                       ResaltadoHasta="{Binding ResaltadoHasta}"
                                       EncuadrarRecorrido="True"
                                       SeguirCamion="False"
                                       MapaJuego="{Binding MapaJuego}"
                                       VersionMapaJuego="{Binding MapaJuego.Version}" />
                    <TextBlock Text="{Binding TextoMapa}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Top"
                               Margin="12"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource Pincel.Texto}" />
                </Grid>
            </Border>

        <Border Grid.Row="1" CornerRadius="8" Background="{StaticResource Pincel.Panel}" Padding="4"
                Visibility="{Binding VerMapa, Converter={StaticResource InversoAVisibilidad}}">
            <DataGrid x:Name="Tabla" ItemsSource="{Binding Filas}" SelectionChanged="Tabla_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Jornada" Binding="{Binding NumeroJornada}" />
                    <DataGridTextColumn Header="Día" Binding="{Binding Dia}" SortMemberPath="Inicio" />
                    <DataGridTextColumn Header="Inicio" Binding="{Binding HoraInicio}" SortMemberPath="Inicio" />
                    <DataGridTextColumn Header="Fin" Binding="{Binding HoraFin}" />
                    <DataGridTextColumn Header="Origen" Binding="{Binding Origen}" />
                    <DataGridTextColumn Header="Destino" Binding="{Binding Destino}" />
                    <DataGridTextColumn Header="Carga" Binding="{Binding Carga}" />
                    <DataGridTextColumn Header="Km" Binding="{Binding Kilometros, StringFormat=N1}" />
                    <DataGridTextColumn Header="Media" Binding="{Binding VelocidadMedia, StringFormat=N0}" />
                    <DataGridTextColumn Header="Máx." Binding="{Binding VelocidadMaxima, StringFormat=N0}" />
                    <DataGridTextColumn Header="Faltas" Binding="{Binding Faltas}" Foreground="{StaticResource Pincel.Urgente}" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
        </Grid>

        <!-- ===== Panel de edición (solo si hay algo que editar) ===== -->
        <Border Grid.Row="2" Grid.Column="3" Width="300" Margin="16,0,0,0" VerticalAlignment="Top"
                Style="{StaticResource Panel}"
                Visibility="{Binding Edicion, Converter={StaticResource NuloAOculto}}">
            <ContentControl Content="{Binding Edicion}" />
        </Border>

        <!-- ===== Resumen de lo que se ve ===== -->
        <TextBlock Grid.Row="3" Grid.Column="2" Grid.ColumnSpan="2"
                   Text="{Binding Resumen}"
                   Margin="4,10,0,0"
                   Foreground="{StaticResource Pincel.TextoSecundario}" />
    </Grid>
</UserControl>
