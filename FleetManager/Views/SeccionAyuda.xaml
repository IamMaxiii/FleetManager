<UserControl x:Class="FleetManager.Views.SeccionAyuda"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i="clr-namespace:FleetManager.Idiomas">

    <!-- Texto fijo: cómo funciona el tacógrafo y cómo planificar la jornada. Sin ViewModel.
         Los textos están en Idiomas\*.json (claves Ayuda.*); **así** sale en negrita. -->

    <UserControl.Resources>
        <Style x:Key="Parrafo" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Pincel.Texto}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="LineHeight" Value="20" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="Punto" TargetType="TextBlock" BasedOn="{StaticResource Parrafo}">
            <Setter Property="Margin" Value="14,0,0,6" />
        </Style>

        <Style x:Key="Nota" TargetType="TextBlock" BasedOn="{StaticResource Parrafo}">
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="Foreground" Value="{StaticResource Pincel.TextoSecundario}" />
        </Style>

        <Style x:Key="Subtitulo" TargetType="TextBlock" BasedOn="{StaticResource Parrafo}">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="Bloque" TargetType="Border" BasedOn="{StaticResource Panel}">
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>

        <Style x:Key="Muestra" TargetType="Border">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Margin" Value="0,3,10,0" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
    </UserControl.Resources>

    <StackPanel MaxWidth="900" HorizontalAlignment="Left">
        <TextBlock Text="{i:Texto Menu.Ayuda}" Style="{StaticResource TituloSeccion}" />

        <!-- ===== Antes de empezar ===== -->
        <Border Style="{StaticResource Bloque}" BorderBrush="{StaticResource Pincel.Aviso}" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="{i:Texto Ayuda.AntesTitulo}" Style="{StaticResource TituloPanel}" />
                <TextBlock i:TextoRico.Clave="Ayuda.AntesTexto" Style="{StaticResource Parrafo}" />
                <TextBlock i:TextoRico.Clave="Ayuda.AntesDescanso" Style="{StaticResource Punto}" />
                <TextBlock i:TextoRico.Clave="Ayuda.AntesPausas" Style="{StaticResource Punto}" />
                <TextBlock i:TextoRico.Clave="Ayuda.AntesPorque" Style="{StaticResource Parrafo}" Margin="0,4,0,8" />
            </StackPanel>
        </Border>

        <!-- ===== Cómo se usa ===== -->
        <Border Style="{StaticResource Bloque}">
            <StackPanel>
                <TextBlock Text="{i:Texto Ayuda.UsoTitulo}" Style="{StaticResource TituloPanel}" />
                <TextBlock i:TextoRico.Clave="Ayuda.Uso1" Style="{StaticResource Punto}" />
                <TextBlock i:TextoRico.Clave="Ayuda.Uso2" Style="{StaticResource Punto}" />
                <TextBlock i:TextoRico.Clave="Ayuda.Uso3" Style="{StaticResource Punto}" />
                <TextBlock i:TextoRico.Clave="Ayuda.Uso4" Style="{StaticResource Punto}" />
                <TextBlock i:TextoRico.Clave="Ayuda.Uso5" Style="{StaticResource Punto}" />
                <TextBlock i:TextoRico.Clave="Ayuda.Uso6" Style="{StaticResource Punto}" />
            </StackPanel>
        </Border>

        <!-- ===== Actividades ===== -->
        <Border Style="{StaticResource Bloque}">
            <StackPanel>
                <TextBlock Text="{i:Texto Ayuda.ActividadesTitulo}" Style="{StaticResource TituloPanel}" />
                <DockPanel Margin="0,0,0,6">
                    <Border Style="{StaticResource Muestra}" Background="{StaticResource Pincel.Conduccion}" />
                    <TextBlock i:TextoRico.Clave="Ayuda.ActConduccion" Style="{StaticResource Parrafo}" Margin="0" />
                </DockPanel>
                <DockPanel Margin="0,0,0,6">
                    <Border Style="{StaticResource Muestra}" Background="{StaticResource Pincel.OtrosTrabajos}" />
                    <TextBlock i:TextoRico.Clave="Ayuda.ActOtros" Style="{StaticResource Parrafo}" Margin="0" />
                </DockPanel>
                <DockPanel Margin="0,0,0,6">
                    <Border Style="{StaticResource Muestra}" Background="{StaticResource Pincel.Disponibilidad}" />
                    <TextBlock i:TextoRico.Clave="Ayuda.ActDisponibilidad" Style="{StaticResource Parrafo}" Margin="0" />
                </DockPanel>
                <DockPanel>
                    <Border Style="{StaticResource Muestra}" Background="{StaticResource Pincel.Descanso}" />
                    <TextBlock i:TextoRico.Clave="Ayuda.ActDescanso" Style="{StaticResource Parrafo}" Margin="0" />
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- ===== Conducción ===== -->
        <Border Style="{StaticResource Bloque}">
            <StackPanel>
                <TextBlock Text="{i:Texto Ayuda.ConduccionTitulo}" Style="{StaticResource TituloPanel}" />
                <TextBlock i:TextoRico.Clave="Ayuda.Conduccion1" Style="{StaticResource Punto}" />
                <TextBlock i:TextoRico.Clave="Ayuda.Conduccion2" Style="{StaticResource Punto}" />
                <TextBlock i:TextoRico.Clave="Ayuda.Conduccion3" Style="{StaticResource Punto}" />
                <TextBlock i:TextoRico.Clave="Ayuda.Conduccion4" Style="{StaticResource Punto}" />
            </StackPanel>
        </Border>

        <!-- ===== Descansos ===== -->
        <Border Style="{StaticResource Bloque}">
            <StackPanel>
                <TextBlock Text="{i:Texto Ayuda.DescansosTitulo}" Style="{StaticResource TituloPanel}" />
                <TextBlock Text="{i:Texto Ayuda.DiarioTitulo}" Style="{StaticResource Subtitulo}" />
                <TextBlock i:TextoRico.Clave="Ayuda.Diario1" Style="{StaticResource Punto}" />
                <TextBlock i:TextoRico.Clave="Ayuda.Diario2" Style="{StaticResource Punto}" />
                <TextBlock i:TextoRico.Clave="Ayuda.Diario3" Style="{StaticResource Punto}" />
                <TextBlock i:TextoRico.Clave="Ayuda.Diario4" Style="{StaticResource Punto}" />

                <TextBlock Text="{i:Texto Ayuda.SemanalTitulo}" Style="{StaticResource Subtitulo}" Margin="0,8,0,8" />
                <TextBlock i:TextoRico.Clave="Ayuda.Semanal1" Style="{StaticResource Punto}" />
                <TextBlock i:TextoRico.Clave="Ayuda.Semanal2" Style="{StaticResource Punto}" />
                <TextBlock i:TextoRico.Clave="Ayuda.Semanal3" Style="{StaticResource Punto}" />
            </StackPanel>
        </Border>

        <!-- ===== Ejemplo ===== -->
        <Border Style="{StaticResource Bloque}">
            <StackPanel>
                <TextBlock Text="{i:Texto Ayuda.EjemploTitulo}" Style="{StaticResource TituloPanel}" />
                <TextBlock i:TextoRico.Clave="Ayuda.Ejemplo1" Style="{StaticResource Punto}" />
                <TextBlock i:TextoRico.Clave="Ayuda.Ejemplo2" Style="{StaticResource Punto}" />
                <TextBlock i:TextoRico.Clave="Ayuda.Ejemplo3" Style="{StaticResource Punto}" />
                <TextBlock i:TextoRico.Clave="Ayuda.Ejemplo4" Style="{StaticResource Punto}" />
                <TextBlock i:TextoRico.Clave="Ayuda.Ejemplo5" Style="{StaticResource Punto}" />
                <TextBlock i:TextoRico.Clave="Ayuda.EjemploConsejo" Style="{StaticResource Nota}" />
            </StackPanel>
        </Border>

        <!-- ===== Faltas ===== -->
        <Border Style="{StaticResource Bloque}" Margin="0">
            <StackPanel>
                <TextBlock Text="{i:Texto Ayuda.FaltasTitulo}" Style="{StaticResource TituloPanel}" />
                <TextBlock i:TextoRico.Clave="Ayuda.FaltaVelocidad" Style="{StaticResource Punto}" />
                <TextBlock i:TextoRico.Clave="Ayuda.FaltaConduccion" Style="{StaticResource Punto}" />
                <TextBlock i:TextoRico.Clave="Ayuda.FaltasNota" Style="{StaticResource Nota}" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
